{
  "name": "rahul0705.github.io",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "audit:unused": "knip",
    "audit": "npm audit --audit-level=high",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:all": "npm run lint:code && npm run lint:styles && npm run lint:markdown",
    "lint:code": "astro sync 1>&2 && oxlint",
    "lint:code:fix": "astro sync 1>&2 && oxlint --fix",
    "lint:styles": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "lint:styles:fix": "stylelint --fix \"**/*.css\" --ignore-path .gitignore",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore-path .gitignore",
    "lint:markdown:fix": "markdownlint --fix \"**/*.md\" --ignore-path .gitignore",
    "lint:resume:markdown": "markdownlint dist/resume.md",
    "lighthouse:ci": "lhci autorun",
    "quality": "npm run format && npm run lint:all && npm run spellcheck && npm run audit:unused && npm run typecheck && npm run test:unit && npm run build && npm run validate:build && npm run lint:resume:markdown && npm run test:e2e && npm run lighthouse:ci",
    "spellcheck": "cspell \"**\"",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "astro check",
    "validate:build": "node --experimental-strip-types scripts/validate-build.ts",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@lucide/astro": "^1.55.0",
    "@rm-industries/content-model": "1.1.9",
    "@sveltia/cms": "0.250.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@catppuccin/daisyui": "^2.1.1",
    "@catppuccin/palette": "^1.8.0",
    "@jsonresume/schema": "^1.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@vitest/coverage-v8": "^5.0.0",
    "astro": "^7.3.8",
    "cspell": "^10.3.6",
    "daisyui": "^5.7.50",
    "knip": "^6.41.0",
    "markdownlint-cli": "^0.49.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pagefind": "^1.5.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^26.0.0",
    "npm": "^11.0.0"
  }
}
