{
  "name": "rahul0705.github.io",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "astro:check": "astro check",
    "audit:unused": "knip",
    "audit": "npm audit --audit-level=high",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:all": "npm run lint:code && npm run lint:css && npm run lint:markdown",
    "lint:code": "oxlint",
    "lint:code:fix": "oxlint --fix",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "lint:css:fix": "stylelint --fix \"**/*.css\" --ignore-path .gitignore",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore-path .gitignore",
    "lint:markdown:fix": "markdownlint --fix \"**/*.md\" --ignore-path .gitignore",
    "lint:resume:markdown": "markdownlint dist/resume.md",
    "lighthouse:ci": "lhci autorun",
    "quality": "npm run format && npm run lint:all && npm run spellcheck && npm run typecheck && npm run astro:check && npm run test:unit && npm run build && npm run lint:resume:markdown && npm run test:e2e && npm run lighthouse:ci",
    "spellcheck": "cspell \"**\"",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "astro sync && tsc --noEmit",
    "verify:resume:markdown": "npm run build && npm run lint:resume:markdown"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@lucide/astro": "^1.27.0",
    "@sveltia/cms": "^0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@axe-core/playwright": "^4.12.1",
    "@catppuccin/daisyui": "^2.1.1",
    "@catppuccin/palette": "^1.8.0",
    "@jsonresume/schema": "^1.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "astro": "^7.0.2",
    "cspell": "^10.0.1",
    "daisyui": "^5.5.23",
    "knip": "^6.29.0",
    "markdownlint-cli": "^0.49.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.72.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
