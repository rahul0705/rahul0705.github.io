---
import BaseLayout from './BaseLayout.astro';
import ContentMeta from '../components/ui/ContentMeta.astro';
import TagList from '../components/ui/TagList.astro';
import BlogCover from '../components/blog/BlogCover.astro';
import { getPublishedAt } from '../lib/blog';

const { entry } = Astro.props;
const publishedAt = getPublishedAt(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/blog/${entry.id}/`}
  image={entry.data.coverImage?.src}
  type="article"
  publishedAt={publishedAt}
>
  <article class="mx-auto max-w-3xl px-6 py-20">
    <header class="mb-12">
      <ContentMeta date={publishedAt} label={entry.data.categories[0]} />
      <div class="mt-6">
        <BlogCover image={entry.data.coverImage} title={entry.data.title} class="aspect-[2/1] rounded-box" />
      </div>
      <h1 class="mt-8 text-5xl font-bold tracking-tight">
        {entry.data.title}
      </h1>

      {entry.data.description && <p class="mt-4 text-xl text-base-content/70">{entry.data.description}</p>}
      <div class="mt-6"><TagList items={entry.data.tags} label="Article tags" /></div>

    </header>

    <div class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-p:leading-8 prose-p:text-base-content/80 prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-blockquote:border-primary prose-blockquote:text-base-content/75 prose-code:text-primary prose-pre:bg-neutral prose-pre:text-neutral-content">
      <slot />
    </div>
  </article>
</BaseLayout>
