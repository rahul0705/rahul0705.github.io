---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import ContentMeta from '../components/ui/ContentMeta.astro';
import TagList from '../components/ui/TagList.astro';
import BlogCover from '../components/blog/BlogCover.astro';
import TableOfContents, { type TableOfContentsHeading } from '../components/blog/TableOfContents.astro';
import { getPublishedAt } from '../lib/blog';
import { articleContentClasses } from '../styles/article-classes';

interface Props {
  entry: CollectionEntry<'blog'>;
  headings?: TableOfContentsHeading[];
}

const { entry, headings = [] } = Astro.props;
const publishedAt = getPublishedAt(entry);
const hasTableOfContents = entry.data.tableOfContents;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/blog/${entry.id}/`}
  image={entry.data.coverImage?.src}
  type="article"
  publishedAt={publishedAt}
  updatedAt={entry.data.updatedDate}
  articleSection={entry.data.section}
  articleTags={entry.data.tags}
>
  <article class="mx-auto max-w-7xl px-6 py-20">
    <header class="mx-auto mb-12 max-w-3xl">
      <ContentMeta date={publishedAt} updatedDate={entry.data.updatedDate} label={entry.data.section} />
      <div class="mt-6">
        <BlogCover image={entry.data.coverImage} title={entry.data.title} class="aspect-2/1 rounded-box" />
      </div>
      <h1 class="mt-8 text-5xl font-bold tracking-tight">
        {entry.data.title}
      </h1>

      {entry.data.description && <p class="mt-4 text-xl text-base-content/70">{entry.data.description}</p>}
      <div class="mt-6"><TagList items={entry.data.tags} label="Article tags" /></div>

    </header>

    <div
      class:list={[
        'mx-auto grid max-w-3xl',
        hasTableOfContents && 'xl:max-w-6xl xl:grid-cols-[minmax(0,48rem)_18rem] xl:items-start xl:gap-12',
      ]}
    >
      <div class={articleContentClasses}>
        <slot />
      </div>

      {
        hasTableOfContents && (
          <aside
            class="order-first mb-10 xl:sticky xl:top-20 xl:order-last xl:mb-0 xl:max-h-[calc(100vh-6rem)] xl:overflow-y-auto"
            aria-label="Article navigation"
          >
            <TableOfContents headings={headings} />
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>
