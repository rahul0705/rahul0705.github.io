---
import Container from './Container.astro';

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  id?: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  headerClass?: string;
  contentClass?: string;
}

const {
  title,
  description,
  eyebrow,
  id,
  size = 'md',
  class: className,
  headerClass,
  contentClass,
} = Astro.props;

const spacing = {
  sm: 'py-8',
  md: 'py-10',
  lg: 'py-16',
};
---

<section id={id} class={`${spacing[size]} ${className ?? ''}`}>
  <Container>
    <slot name="header">
      {
        (eyebrow || title || description) && (
          <div class={`mb-6 max-w-2xl ${headerClass ?? ''}`}>
            {eyebrow && <p class="mb-3 font-mono text-sm font-medium uppercase tracking-[0.12em] text-primary">{eyebrow}</p>}

            {title && <h2 class="text-2xl leading-tight font-semibold">{title}</h2>}

            {description && <p class="mt-3 text-base-content/70">{description}</p>}

            <slot name="header-actions" />
          </div>
        )
      }
    </slot>

    <div class={contentClass ?? ''}>
      <slot />
    </div>
  </Container>
</section>
