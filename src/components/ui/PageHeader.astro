---
import Container from './Container.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  size?: 'default' | 'compact';
}

const { eyebrow, title, description, size = 'default' } = Astro.props;
const spacing = size === 'compact' ? 'py-12 md:py-16' : 'py-16 md:py-24';
---

<header class="hero">
  <div class={`hero-content w-full max-w-none px-0 ${spacing}`}>
    <Container>
      <div class="max-w-3xl">
      {eyebrow && <p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-primary">{eyebrow}</p>}
      <h1 class="text-4xl font-bold tracking-tight md:text-6xl">{title}</h1>
      {description && <p class="mt-5 text-lg leading-relaxed text-base-content/70 md:text-xl">{description}</p>}
      <div class="mt-8 flex flex-wrap gap-3">
        <slot name="actions" />
      </div>
      </div>
    </Container>
  </div>
</header>
