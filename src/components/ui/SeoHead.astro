---
import { site } from '../../data/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  canonicalPath = '/',
  image = site.defaultSocialImage,
  type = 'website',
  publishedAt,
  noindex = false,
} = Astro.props;

const normalizedPath = (() => {
  const path = `/${canonicalPath}`.replace(/\/{2,}/g, '/');
  return path === '/' ? path : `${path.replace(/\/$/, '')}/`;
})();
const canonicalUrl = new URL(normalizedPath, site.url).href;
const imageUrl = new URL(image, site.url).href;
const pageTitle = title ? `${title} - ${site.title}` : site.title;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content={site.title} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={pageTitle} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={pageTitle} />

{type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
