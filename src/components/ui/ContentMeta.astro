---
interface Props {
  date?: Date;
  updatedDate?: Date;
  label?: string;
  emphasis?: boolean;
}

const { date, updatedDate, label, emphasis = false } = Astro.props;
const formatter = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const formattedDate = date && formatter.format(date);
const formattedUpdatedDate = updatedDate && formatter.format(updatedDate);
const dateText = formattedUpdatedDate ? `Published ${formattedDate} · Updated ${formattedUpdatedDate}` : formattedDate;
---

{(dateText || label) && (
  <p class:list={['text-sm text-base-content/60', emphasis && 'font-semibold']}>
    {[label, dateText].filter(Boolean).join(' - ')}
  </p>
)}
