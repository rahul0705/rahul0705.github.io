---
interface Props {
  href?: string;
  hover?: boolean;
  padding?: 'sm' | 'md' | 'lg';
}

const { href, hover = Boolean(Astro.props.href), padding = 'md' } = Astro.props;

const paddingClasses = {
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const cardClasses = [
  'card',
  'rounded-box',
  'bg-base-100',
  'shadow-xl',

  hover && 'transition-shadow duration-300 hover:shadow-2xl',
]
  .filter(Boolean)
  .join(' ');

const bodyClasses = ['card-body', paddingClasses[padding]].join(' ');
---

{
  href ? (
    <a href={href} class={cardClasses}>
      <div class={bodyClasses}><slot /></div>
    </a>
  ) : (
    <div class={cardClasses}>
      <div class={bodyClasses}><slot /></div>
    </div>
  )
}
