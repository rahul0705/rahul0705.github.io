---
import Card from '../ui/Card.astro';
import Section from '../ui/Section.astro';
import TagList from '../ui/TagList.astro';

interface Props {
  title: string;
  description: string;
  intro: string;
  highlights: string[];
  focusAreas: string[];
}

const { title, description, intro, highlights, focusAreas } = Astro.props;
---

<Section id="about" title={title} description={description}>
  <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
    <Card padding="lg">
      <slot name="body">
        <p class="text-lg leading-8 text-base-content/80">{intro}</p>

        <div class="mt-6"><TagList items={focusAreas} variant="skill" label="Focus areas" /></div>
      </slot>
    </Card>

    <slot name="sidebar">
      <div class="grid gap-4">
        {highlights.map((item) => (
          <div class="alert border border-base-300 bg-base-200/50 shadow-sm">
            <p class="text-sm font-medium">{item}</p>
          </div>
        ))}
      </div>
    </slot>
  </div>
</Section>
