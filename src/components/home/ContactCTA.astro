---
import Card from '../ui/Card.astro';
import Container from '../ui/Container.astro';
import { socialLinks } from '../../config/site';

type ActionVariant = 'primary' | 'outline' | 'ghost';

interface ContactAction {
  label: string;
  href: string;
  variant?: ActionVariant;
  external?: boolean;
}

const defaultActions: ContactAction[] = [
  { ...socialLinks.Email, variant: 'primary' },
  { ...socialLinks.LinkedIn, variant: 'outline' },
  { ...socialLinks.GitHub, variant: 'outline' },
];

const buttonClasses: Record<ActionVariant, string> = {
  primary: 'btn btn-primary',
  outline: 'btn btn-outline',
  ghost: 'btn btn-ghost',
};

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  actions?: ContactAction[];
}

const {
  eyebrow = 'Contact',
  title = "Let's talk software.",
  description = "Have a question about an article or a project? Get in touch.",
  actions = defaultActions,
} = Astro.props;
---

<section class="pb-20">
  <Container>
    <Card padding="lg">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="font-mono text-sm font-medium uppercase tracking-[0.12em] text-primary">{eyebrow}</p>
          <h2 class="mt-2 text-3xl leading-tight font-bold tracking-[-0.04em] md:text-4xl">{title}</h2>
          <p class="mt-3 text-base-content/70">{description}</p>
        </div>

        <div class="flex flex-wrap gap-3">
          {actions.map((action) => {
            const buttonClass = buttonClasses[action.variant ?? 'outline'];

            return (
              <a
                href={action.href}
                target={action.external ? '_blank' : undefined}
                rel={action.external ? 'noopener noreferrer' : undefined}
                class={buttonClass}
              >
                {action.label}
              </a>
            );
          })}

          <slot name="actions" />
        </div>
      </div>
    </Card>
  </Container>
</section>
