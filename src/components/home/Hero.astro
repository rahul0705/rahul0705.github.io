---
import { site } from '../../data/site';
import { siteConfig } from '../../config/site';
import type { SocialNetwork } from '../../lib/social-networks';
import Container from '../ui/Container.astro';
import SocialIcon from '../ui/SocialIcon.astro';
import { Image } from 'astro:assets';
import heroImage from '../../assets/covers/code.jpg';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  links?: Array<{ label: SocialNetwork; href: string; external?: boolean }>;
}

const {
  eyebrow = site.title,
  title = site.name,
  description = site.description,
  primaryHref = '/resume',
  primaryLabel = 'View Resume',
  secondaryHref = '/blog',
  secondaryLabel = 'Read Articles',
  links = siteConfig.socialLinks.map((link) => ({ ...link })),
} = Astro.props;
---

<section class="hero">
  <div class="hero-content w-full max-w-none px-0 py-12 lg:py-20">
    <Container>
      <div class="flex flex-col-reverse items-center gap-8 lg:flex-row lg:gap-12">
      <div class="min-w-0 text-center lg:w-1/2 lg:text-left">
      <p class="mb-3 text-lg font-semibold text-primary">
        {eyebrow}
      </p>

      <h1 class="text-4xl leading-tight font-bold tracking-tight md:text-5xl">
        {title}
      </h1>

      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-base-content/80 md:text-lg lg:mx-0">
        {description}
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-3 lg:justify-start">
        <slot name="actions" />

        <a href={primaryHref} class="btn btn-primary btn-lg">{primaryLabel}</a>

        <a href={secondaryHref} class="btn btn-outline btn-lg">{secondaryLabel}</a>
      </div>

      <div class="mt-6 flex flex-wrap justify-center gap-2 lg:justify-start">
        {links.map((link) => {
          return (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="btn btn-ghost btn-sm gap-2"
              aria-label={link.label}
            >
              <SocialIcon network={link.label} />
              <span>{link.label}</span>
            </a>
          );
        })}

        <slot name="links" />
      </div>
      </div>
      <div class="w-full max-w-xl lg:w-1/2">
        <Image src={heroImage} alt="" width={900} height={600} class="aspect-3/2 w-full rounded-xl object-cover shadow-md" loading="eager" fetchpriority="high" />
      </div>
      </div>
    </Container>
  </div>
</section>
