---
import Container from '../ui/Container.astro';

interface Props {
  items: Array<{ label: string; value: string }>;
  columns?: 2 | 3 | 4;
}

const { items, columns = 3 } = Astro.props;
const statsGridClasses = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-3',
  4: 'md:grid-cols-4',
};
---

<section class="pb-6">
  <Container>
    <div class={`stats stats-vertical grid w-full shadow-sm ${statsGridClasses[columns]}`}>
      {items.map((item) => (
        <div class="stat">
          <p class="stat-value text-2xl">{item.value}</p>
          <p class="stat-title uppercase tracking-[0.2em]">{item.label}</p>
        </div>
      ))}
    </div>
  </Container>
</section>
