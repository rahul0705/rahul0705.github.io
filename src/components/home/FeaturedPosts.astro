---
import FeaturedPostCard from './FeaturedPostCard.astro';
import Section from '../ui/Section.astro';
import { ArrowRight } from '@lucide/astro';

import { getPublishedPosts } from '../../lib/blog';

interface Props {
  title?: string;
  description?: string;
  limit?: number;
  posts?: Array<any>;
}

const { title = 'Featured Articles', description = 'A few recent write-ups worth a read.', limit = 3, posts: providedPosts } = Astro.props;

const fallbackPosts = await getPublishedPosts();
const posts = (providedPosts ?? fallbackPosts).slice(0, limit);
---

<Section title={title} description={description}>
  <a slot="header-actions" class="btn btn-ghost btn-sm mt-5 gap-2 px-0 text-primary" href="/blog">
    View all articles <ArrowRight class="size-4" aria-hidden="true" />
  </a>

  <div class="border-t border-base-300">
    {posts.map((post, index) => <FeaturedPostCard post={post} index={index} />)}
  </div>
</Section>
