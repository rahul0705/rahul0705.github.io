---
import FeaturedPostCard from './FeaturedPostCard.astro';
import Section from '../ui/Section.astro';
import { ArrowRight } from '@lucide/astro';

import { getPublishedPosts } from '../../lib/blog';

interface Props {
  title?: string;
  description?: string;
  limit?: number;
  posts?: Array<any>;
}

const { title = 'Featured Articles', description = 'A few recent write-ups worth a read.', limit = 3, posts: providedPosts } = Astro.props;

const fallbackPosts = await getPublishedPosts();
const posts = (providedPosts ?? fallbackPosts).slice(0, limit);
---

<Section title={title} description={description}>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <FeaturedPostCard post={post} />)}
  </div>
  <div class="mt-8 flex justify-center">
    <a class="btn btn-primary gap-2" href="/blog">View all articles <ArrowRight class="size-4" aria-hidden="true" /></a>
  </div>
</Section>
