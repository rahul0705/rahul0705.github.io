---
import { ArrowUpRight, BookOpen } from '@lucide/astro';
import BlogCover from '../blog/BlogCover.astro';
import ContentMeta from '../ui/ContentMeta.astro';
import TagList from '../ui/TagList.astro';

interface Props {
  post: any;
  index: number;
}

const { post, index } = Astro.props;
---

<a
  href={`/blog/${post.id}`}
  class="group grid gap-5 border-b border-base-300 py-7 transition-colors first:pt-0 hover:border-primary/50 md:grid-cols-[3.5rem_minmax(0,1fr)_11rem] md:items-center"
>
  <span class="font-mono text-sm text-primary/80">{String(index + 1).padStart(2, '0')}</span>

  <div>
    <div class="mb-3 flex items-center gap-2 text-sm text-base-content/60">
      <BookOpen class="size-4" aria-hidden="true" />
      <ContentMeta date={post.data.publishedAt} label={post.data.categories[0] ?? 'Article'} />
    </div>
    <div class="flex items-start justify-between gap-5">
      <h3 class="text-2xl font-semibold tracking-tight group-hover:text-primary">{post.data.title}</h3>
      <ArrowUpRight
        class="mt-1 size-5 shrink-0 transition-transform duration-200 group-hover:-translate-y-1 group-hover:translate-x-1"
        aria-hidden="true"
      />
    </div>
    {post.data.description && <p class="mt-3 max-w-2xl leading-relaxed text-base-content/70">{post.data.description}</p>}
    <div class="mt-4"><TagList items={post.data.tags.slice(0, 3)} label="Article tags" /></div>
  </div>

  <BlogCover image={post.data.coverImage} title={post.data.title} class="hidden aspect-[4/3] rounded-box md:block" />
</a>
