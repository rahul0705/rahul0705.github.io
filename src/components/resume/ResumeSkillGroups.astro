---
interface Props {
  groups: Array<{ name: string; keywords: string[] }>;
}

const { groups } = Astro.props;
---

<section class="print-avoid-break">
  <h2 class="text-2xl font-bold tracking-tight">Skills</h2>
  <div class="mt-6 grid gap-5 md:grid-cols-2">
    {groups.map((group) => (
      <div>
        <h3 class="font-semibold">{group.name}</h3>
        <p class="mt-1 leading-relaxed text-base-content/70">{group.keywords.join(', ')}</p>
      </div>
    ))}
  </div>
</section>
