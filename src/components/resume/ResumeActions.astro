---
import { Download } from '@lucide/astro';
import Container from '../ui/Container.astro';
---

<div class="no-print border-b border-base-300 bg-base-100">
  <Container>
    <div class="flex justify-end py-2">
      <button
        type="button"
        class="btn btn-primary btn-sm gap-2"
        popovertarget="resume-actions-menu"
        style="anchor-name: --resume-actions-menu"
      >
        <Download class="size-4" aria-hidden="true" />
        Export Resume
      </button>

      <ul
        id="resume-actions-menu"
        class="dropdown dropdown-end menu mt-2 w-52 rounded-box bg-base-100 p-2 shadow-lg"
        popover
        style="position-anchor: --resume-actions-menu"
      >
        <li><button type="button" data-print-resume>Print Resume</button></li>
        <li><a href="/resume.json" download="rahul-mohandas-resume.json" rel="nofollow">Download JSON</a></li>
        <li><a href="/resume.txt" download="rahul-mohandas-resume.txt" rel="nofollow">Download TXT</a></li>
        <li><a href="/resume.md" download="rahul-mohandas-resume.md" rel="nofollow">Download Markdown</a></li>
      </ul>
    </div>
  </Container>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-print-resume]').forEach((button) => {
    button.addEventListener('click', () => window.print());
  });
</script>
