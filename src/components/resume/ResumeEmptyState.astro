---
import Card from '../ui/Card.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Resume details are being organized',
  description = 'This page is ready for experience, education, and selected skills as they are added.',
} = Astro.props;
---

<Card hover={false} padding="lg">
  <p class="text-lg font-semibold">{title}</p>
  <p class="mt-2 max-w-2xl leading-relaxed text-base-content/70">{description}</p>
</Card>
