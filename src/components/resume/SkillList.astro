---
import type { SkillCatalogEntry, SkillId } from '../../data/resume/skills';
import { skillCatalog } from '../../data/resume/skills';
import Badge from '../ui/Badge.astro';

interface Props {
  skills?: SkillId[];
  size?: 'sm' | 'md' | 'lg';
  label?: string;
}

const { skills = [], size = 'md', label } = Astro.props;
---

{skills.length > 0 && (
  <ul class="flex flex-wrap gap-2" aria-label={label}>
    {skills.map((skillId) => {
      const skill: SkillCatalogEntry = skillCatalog[skillId];
      return (
        <li class="tooltip" data-tip={skill.description} tabindex="0">
          {skill.href ? (
            <a href={skill.href} target="_blank" rel="noopener noreferrer" aria-label={`${skill.name}: ${skill.description}`}>
              <Badge variant="skill" size={size}>{skill.name}</Badge>
            </a>
          ) : (
            <span aria-label={`${skill.name}: ${skill.description}`}>
              <Badge variant="skill" size={size}>{skill.name}</Badge>
            </span>
          )}
        </li>
      );
    })}
  </ul>
)}
