---
import { BriefcaseBusiness, GraduationCap } from '@lucide/astro';
import type { SkillId } from '../../data/resume/skills';
import SkillList from './SkillList.astro';

interface TimelineItem {
  title: string;
  href?: string;
  subtitle?: string;
  startDate?: string;
  endDate?: string;
  description?: string;
  highlights?: string[];
  skills?: SkillId[];
}

interface Props {
  items: TimelineItem[];
  type: 'work' | 'education';
}

const { items, type } = Astro.props;
const MarkerIcon = type === 'work' ? BriefcaseBusiness : GraduationCap;

const formatDate = (value?: string) =>
  value && new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}-01T00:00:00Z`));

const formatPeriod = (item: TimelineItem) => {
  const start = formatDate(item.startDate);
  const end = item.endDate ? formatDate(item.endDate) : item.startDate ? 'Present' : undefined;
  return [start, end].filter(Boolean).join(' - ');
};
---

<ul class="resume-timeline timeline timeline-snap-icon max-md:timeline-compact timeline-vertical">
  {items.map((item, index) => (
    <li class="print-avoid-break">
      {index > 0 && <hr />}
      <div class:list={['timeline-middle', 'no-print-marker']}>
        <span class="flex size-9 items-center justify-center rounded-full border-2 border-base-100 bg-primary text-primary-content shadow-sm">
          <MarkerIcon class="size-4" aria-hidden="true" />
        </span>
      </div>
      <article class:list={['timeline-box', 'bg-base-100', 'shadow-sm', index % 2 === 0 ? 'timeline-start' : 'timeline-end']}>
        <div class="space-y-4">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
            <div>
              <h3 class="card-title text-xl">
                {item.href ? <a href={item.href} class="link link-hover">{item.title}</a> : item.title}
              </h3>
              {item.subtitle && <p class="text-base-content/70">{item.subtitle}</p>}
            </div>
            {formatPeriod(item) && <p class="shrink-0 text-sm text-base-content/60">{formatPeriod(item)}</p>}
          </div>
          {item.description && <p class="leading-relaxed text-base-content/75">{item.description}</p>}
          {item.highlights && item.highlights.length > 0 && (
            <ul class="list-disc space-y-1 ps-5 text-base-content/75">
              {item.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          )}
          {item.skills && item.skills.length > 0 && (
            <SkillList skills={item.skills} label={`${item.title} skills`} />
          )}
        </div>
      </article>
      {index < items.length - 1 && <hr />}
    </li>
  ))}
</ul>
