---
import type { ExperienceOrganization, ExperienceRole } from '../../data/resume/experience';
import type { ContentLink } from '../../config/content-model';
import Timeline from './Timeline.astro';

interface TimelineRole {
  company: ExperienceOrganization;
  project: { name: string; href?: string; additionalInformation: ContentLink[] };
  role: ExperienceRole;
}

interface Props {
  title: string;
  description?: string;
  companies: ExperienceOrganization[];
}

const { title, description, companies } = Astro.props;
const roles: TimelineRole[] = companies.flatMap((company) =>
  company.projects.flatMap((project) => project.roles.map((role) => ({ company, project, role }))),
).sort((a, b) => (b.role.startDate ?? '').localeCompare(a.role.startDate ?? ''));

const timelineItems = roles.map(({ company, project, role }) => ({
  title: role.title,
  subtitle: company.name,
  subtitleHref: company.href,
  subtitleDetail: project.name,
  subtitleDetailHref: project.href,
  additionalInformation: project.additionalInformation,
  startDate: role.startDate,
  endDate: role.endDate,
  description: role.description,
  highlights: role.highlights,
  skills: role.skills,
}));
---

{roles.length > 0 && (
  <section>
    <div class="mb-8 max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight">{title}</h2>
      {description && <p class="mt-2 text-base-content/70">{description}</p>}
    </div>

    <Timeline items={timelineItems} type="work" />
  </section>
)}
