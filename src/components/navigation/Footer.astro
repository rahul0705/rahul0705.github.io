---
import { siteConfig } from '../../config/site';
import { site } from '../../data/site';
---

<footer class="mt-16 bg-base-200">
  <div class="footer footer-center mx-auto max-w-6xl px-6 py-12">
    <aside class="max-w-md">
      <h2 class="footer-title">{site.name}</h2>
      <p class="text-base-content/70">{site.description}</p>
    </aside>

    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-3">

      {
        [...siteConfig.socialLinks, ...siteConfig.navigation.footer].map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="link link-hover"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <aside class="text-sm text-base-content/60 ">
      <p>© {new Date().getFullYear()} {site.name}</p>
    </aside>
  </div>
</footer>
