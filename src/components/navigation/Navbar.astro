---
import { sitePath } from '../../lib/site-url';
import { Menu, Search } from '@lucide/astro';
import { siteConfig } from '../../config/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-base-100 shadow-sm">
  <div class="mx-auto max-w-6xl px-6">
    <div class="navbar min-h-(--site-navbar-height) px-0">
      <div class="navbar-start flex-1">
        <a href={sitePath('/')} class="text-lg font-semibold tracking-tight"> {siteConfig.title} </a>
      </div>

      <nav class="navbar-end hidden gap-1 md:flex" aria-label="Primary navigation">
        {
          siteConfig.navigation.primary.map((item) => (
            <a
              href={sitePath(item.href)}
              class:list={['btn btn-ghost text-base', currentPath.startsWith(sitePath(item.href)) && 'btn-active']}
            >
              {item.label}
            </a>
          ))
        }

      </nav>

      <button
        type="button"
        class="btn btn-ghost btn-square ml-1"
        aria-label="Search articles"
        aria-haspopup="dialog"
        aria-controls="article-search-dialog"
        data-search-open
        hidden
      >
        <Search aria-hidden="true" />
      </button>

      <!-- Mobile Menu -->
      <div class="flex-none md:hidden">
        <button
          type="button"
          class="btn btn-ghost btn-square"
          aria-label="Open navigation menu"
          popovertarget="mobile-navigation-menu"
          style="anchor-name: --mobile-navigation-menu"
        >
          <Menu aria-hidden="true" />
        </button>

        <ul
          id="mobile-navigation-menu"
          class="dropdown dropdown-end menu mt-3 w-52 rounded-box bg-base-100 p-2 shadow-lg"
          popover
          style="position-anchor: --mobile-navigation-menu"
        >
          {
            siteConfig.navigation.primary.map((item) => (
              <li>
                <a href={sitePath(item.href)}>{item.label}</a>
              </li>
            ))
          }

        </ul>
      </div>
    </div>
  </div>
</header>
