---
import { Menu } from '@lucide/astro';
import { socials } from '../../data/socials';

const navItems = [
  {
    label: 'Articles',
    href: '/blog',
  },
  {
    label: 'Resume',
    href: '/resume',
  },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-base-300 bg-base-100/80 backdrop-blur">
  <div class="mx-auto max-w-5xl px-6">
    <div class="navbar px-0 min-h-16">
      <div class="flex-1">
        <a href="/" class="text-lg font-semibold tracking-tight"> Rahul Mohandas </a>
      </div>

      <div class="hidden md:flex gap-1">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={['btn btn-ghost btn-sm', currentPath.startsWith(item.href) && 'btn-active']}
            >
              {item.label}
            </a>
          ))
        }

        <a
          href={socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost btn-sm"
        >
          GitHub
        </a>
      </div>

      <!-- Mobile Menu -->
      <div class="md:hidden">
        <button
          type="button"
          class="btn btn-ghost btn-square"
          aria-label="Open navigation menu"
          popovertarget="mobile-navigation-menu"
          style="anchor-name: --mobile-navigation-menu"
        >
          <Menu aria-hidden="true" />
        </button>

        <ul
          id="mobile-navigation-menu"
          class="dropdown dropdown-end menu mt-3 w-52 rounded-box bg-base-100 p-2 shadow-lg"
          popover
          style="position-anchor: --mobile-navigation-menu"
        >
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }

          <li>
            <a href={socials.github} target="_blank" rel="noopener noreferrer"> GitHub </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</header>
