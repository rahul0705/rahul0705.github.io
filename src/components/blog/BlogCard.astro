---
import ArticleCardShell from './ArticleCardShell.astro';
import ContentMeta from '../ui/ContentMeta.astro';
import TagList from '../ui/TagList.astro';
import { getPublishedAt } from '../../lib/blog';

interface Props {
  post: any;
  priority?: boolean;
}

const { post, priority = false } = Astro.props;
const publishedAt = getPublishedAt(post);
---

<ArticleCardShell href={`/blog/${post.id}`} image={post.data.coverImage} imageAlt={post.data.coverImageAlt} {priority}>
  <article class="card-body justify-center gap-4 p-6 md:p-8">
    <div>
      <h2 class="card-title text-xl leading-snug">
        {post.data.title}
      </h2>

      {post.data.description && <p class="mt-2 text-base-content/70">{post.data.description}</p>}
    </div>

    <ContentMeta date={publishedAt} label={post.data.section} />
    <TagList items={post.data.tags} label="Article tags" />
  </article>
</ArticleCardShell>
