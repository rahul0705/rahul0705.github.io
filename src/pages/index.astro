---
import BaseLayout from '../layouts/BaseLayout.astro';

import AboutSection from '../components/home/AboutSection.astro';
import ContactCTA from '../components/home/ContactCTA.astro';
import FeaturedPosts from '../components/home/FeaturedPosts.astro';
import Hero from '../components/home/Hero.astro';
import Highlights from '../components/home/Highlights.astro';
import ToolkitSection from '../components/home/ToolkitSection.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <Hero
    eyebrow={site.role}
    title={site.name}
    description={site.description}
    primaryHref="/resume"
    primaryLabel="View Resume"
    secondaryHref="/blog"
    secondaryLabel="Read Articles"
  />
  <Highlights items={site.stats} />
  <AboutSection />
  <ToolkitSection
    title="Technical Toolkit"
    description="Technologies used across cloud platforms, developer tooling, and data-processing systems."
    items={site.toolkit}
  />
  <FeaturedPosts title="Selected Writing" description="Notes on software engineering, systems, and technical projects." />
  <ContactCTA />
</BaseLayout>
