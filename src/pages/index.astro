---
import { sitePath } from '../lib/site-url';
import BaseLayout from '../layouts/BaseLayout.astro';

import AboutSection from '../components/home/AboutSection.astro';
import ContactCTA from '../components/home/ContactCTA.astro';
import FeaturedPosts from '../components/home/FeaturedPosts.astro';
import Hero from '../components/home/Hero.astro';
import Highlights from '../components/home/Highlights.astro';
import ToolkitSection from '../components/home/ToolkitSection.astro';
import Section from '../components/ui/Section.astro';
import { home } from '../data/home';
import { getSiteStats, site } from '../data/site';

const stats = await getSiteStats();
---

<BaseLayout description={home.description}>
  <Hero
    eyebrow={site.role}
    title={site.name}
    description={home.description}
    supportingText={home.hero.supportingText}
    primaryHref="/resume"
    primaryLabel="View Resume"
    secondaryHref="/blog"
    secondaryLabel="Read Articles"
  />
  <Highlights items={stats} />
  <FeaturedPosts {...home.recentArticles} />
  <AboutSection {...home.about} />
  <ToolkitSection {...home.toolkit} />
  <Section title={home.dotfiles.title} description={home.dotfiles.description}>
    <div class="flex flex-wrap gap-3">
      <a href={sitePath(home.dotfiles.setupHref)} class="btn btn-outline">Setup guide</a>
      <a href={home.dotfiles.repositoryHref} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
        View repository
      </a>
    </div>
  </Section>
  <ContactCTA {...home.contact} />
</BaseLayout>
