---
import BaseLayout from '../../layouts/BaseLayout.astro';

import BlogCard from '../../components/blog/BlogCard.astro';
import Container from '../../components/ui/Container.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

import { getPublishedAt, getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
const sections = new Set(posts.map((post) => post.data.section)).size;
const latestArticleDate = posts.reduce<Date | undefined>((latest, post) => {
  const articleDate = post.data.updatedDate ?? getPublishedAt(post);
  return articleDate && (!latest || articleDate > latest) ? articleDate : latest;
}, undefined);
const description = 'Writing about software engineering, distributed systems, cloud infrastructure, and developer tooling.';
---

<BaseLayout title="Articles" {description} canonicalPath="/blog/">
  <PageHeader
    eyebrow="Writing"
    title="Articles"
    {description}
  />
  <Container>
    <div class="pb-20">
      <div class="stats stats-vertical mb-10 w-full shadow-sm sm:stats-horizontal">
        <div class="stat"><p class="stat-value text-2xl">{posts.length}</p><p class="stat-title">Articles</p></div>
        <div class="stat"><p class="stat-value text-2xl">{sections}</p><p class="stat-title">Topics</p></div>
        <div class="stat"><p class="stat-value text-2xl">{latestArticleDate?.getUTCFullYear() ?? '-'}</p><p class="stat-title">Last published or updated</p></div>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => <BlogCard post={post} priority={index === 0} />)}
      </div>
    </div>
  </Container>
</BaseLayout>
