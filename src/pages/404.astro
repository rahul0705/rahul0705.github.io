---
import { sitePath } from '../lib/site-url';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="Your bits could not be found." canonicalPath="/404/" noindex>
  <section class="hero min-h-[60vh]" aria-labelledby="not-found-heading">
    <div class="hero-content text-center">
      <div class="max-w-xl">
        <p class="font-mono text-sm font-medium tracking-[0.2em] text-primary">404</p>
        <h1 id="not-found-heading" class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">Page not found</h1>
        <p class="mt-5 text-lg leading-relaxed text-base-content/70">
          Your bits could not be found. I was hoping they'd be here too.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={sitePath('/')} class="btn btn-primary">Go home</a>
          <a href={sitePath('/blog/')} class="btn btn-outline">Browse articles</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
