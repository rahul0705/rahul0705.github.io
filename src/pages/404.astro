---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you requested could not be found." canonicalPath="/404/" noindex>
  <section class="hero min-h-[60vh]" aria-labelledby="not-found-heading">
    <div class="hero-content text-center">
      <div class="max-w-xl">
        <p class="font-mono text-sm font-medium tracking-[0.2em] text-primary">404</p>
        <h1 id="not-found-heading" class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">Page not found</h1>
        <p class="mt-5 text-lg leading-relaxed text-base-content/70">
          The page may have moved, been removed, or never existed.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/" class="btn btn-primary">Go home</a>
          <a href="/blog/" class="btn btn-outline">Browse articles</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
